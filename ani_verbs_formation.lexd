# -------------------------------------------------------------------------
# VERBS
# -------------------------------------------------------------------------

PATTERNS

Stems_with_Agr[causative,-nasal] [>:>] [<caus>:олл] [>:>] ([<inf>:у] | npst_Inflection | Imperative | still_not_present)
Stems_with_Agr[causative,nasal] [>:>] [<caus>:онн] [>:>] ([<inf>:у] | npst_Inflection | Imperative | still_not_present)
Stems_with_Agr[causative,-nasal] [>:>] [<caus>:олъ] [<aor>:и]
Stems_with_Agr[causative,nasal] [>:>] [<caus>:онлъ] [<aor>:и]
Stems_with_Agr[causative,-nasal] [>:>] [<caus>:олъ] [:и] pst_Inflection
Stems_with_Agr[causative,nasal] [>:>] [<caus>:онлъ] [:и] pst_Inflection


PATTERN Stems_with_Agr

Verb

agrCl [>:>] Verb_class_prefix

agrCl[m] [>:>] [:у] (Verb_class_prefix_i_a | Verb_class_prefix_i_o)
agrCl[-m,-pl] [>:>] [:и] (Verb_class_prefix_i_a | Verb_class_prefix_i_o)
agrCl[-jCl] [>:>] [:у] Verb_class_prefix_u_a
agrCl[jCl] [>:>] [:и] Verb_class_prefix_u_a
agrCl[-sg] [>:>] [<pl>:а] (Verb_class_prefix_i_a | Verb_class_prefix_u_a)
agrCl[-sg] [>:>] [<pl>:о] Verb_class_prefix_i_o

Verb_class_internal(1) :agrCl Verb_class_internal(2) [<V>:] agrCl:

PATTERN still_not_present

[<hab>:е] [>:>] agrCl [>:>] [<snp>:агъий]
[<hab>:е] [>:>] agrCl [>:>] [<snp>:агъи] [>:>] [<pf>:й] [>:>] [<neg>:ссу]

LEXICON agrCl

<m>:в[m]
<f>:й[f,jCl]
<an><sg>:б[sg]
<an><pl>:й[pl,jCl]
<inan1>:б
<inan2>:р

LEXICON pst_Inflection

<prf>:й
<prog>:р
<prog>:радо
<prog>:ралло


LEXICON npst_Inflection

<hab>:е
<hab>><futimp>:е>хъо
<proh>:есхъо
<proh>><opt>:есхъо>до
<fut>:ийа
<npst><ptcp>:ийа
<neg><fut>:еcса


LEXICON Imperative

<imp>:о
<imp>><opt>:о>до


LEXICON pst_Inflection

<hab>:е
<hab>><futimp>:е>хъо
<proh>:есхъо
<proh>><opt>:есхъо>до
<fut>:ийа
<npst><ptcp>:ийа
<neg><fut>:еcса

